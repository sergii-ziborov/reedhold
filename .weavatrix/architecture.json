{
  "architectureContractV": 1,
  "name": "Reedhold protocol workspace",
  "style": "layered-crates",
  "enforcement": "strict",
  "components": [
    {
      "id": "core",
      "name": "Identifiers and errors",
      "paths": ["crates/reedhold-core"]
    },
    {
      "id": "codec",
      "name": "Canonical binary encoding",
      "paths": ["crates/reedhold-codec"]
    },
    {
      "id": "identity",
      "name": "Seeds, roots, devices",
      "paths": ["crates/reedhold-identity"]
    },
    {
      "id": "recovery",
      "name": "Vault and recovery manifest",
      "paths": ["crates/reedhold-recovery"]
    },
    {
      "id": "event",
      "name": "Signed social events",
      "paths": ["crates/reedhold-event"]
    },
    {
      "id": "protocol",
      "name": "Account lifecycle composition",
      "paths": ["crates/reedhold-protocol"]
    },
    {
      "id": "mesh",
      "name": "Discovery, rotating relays, transport ports",
      "paths": ["crates/reedhold-mesh"]
    },
    {
      "id": "ads",
      "name": "Genesis advertising capability",
      "paths": ["crates/reedhold-ads"]
    },
    {
      "id": "storage",
      "name": "Durability classes and budgets",
      "paths": ["crates/reedhold-storage"]
    },
    {
      "id": "chain",
      "name": "Compact checkpoints",
      "paths": ["crates/reedhold-chain"]
    },
    {
      "id": "client",
      "name": "Bounded light client",
      "paths": ["crates/reedhold-client"]
    },
    {
      "id": "api",
      "name": "Sync host session for every UI and MCP",
      "paths": ["crates/reedhold-api"]
    },
    {
      "id": "mcp",
      "name": "Agent MCP adapter",
      "paths": ["crates/reedhold-mcp"]
    },
    {
      "id": "facade",
      "name": "Public crate surface",
      "paths": ["crates/reedhold"]
    }
  ],
  "dependencyRules": [
    {
      "id": "core-is-inward",
      "action": "forbid",
      "from": ["core"],
      "to": [
        "codec",
        "identity",
        "recovery",
        "event",
        "protocol",
        "mesh",
        "storage",
        "chain",
        "client",
        "api",
        "mcp",
        "facade"
      ],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "codec-only-core",
      "action": "forbid",
      "from": ["codec"],
      "to": [
        "identity",
        "recovery",
        "event",
        "protocol",
        "mesh",
        "storage",
        "chain",
        "client",
        "api",
        "mcp",
        "facade"
      ],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "identity-stays-below-protocol",
      "action": "forbid",
      "from": ["identity"],
      "to": [
        "recovery",
        "event",
        "protocol",
        "mesh",
        "storage",
        "chain",
        "client",
        "api",
        "mcp",
        "facade"
      ],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "recovery-does-not-see-events-or-network",
      "action": "forbid",
      "from": ["recovery"],
      "to": ["event", "protocol", "mesh", "storage", "chain", "client", "api", "mcp", "facade"],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "event-does-not-see-recovery-or-network",
      "action": "forbid",
      "from": ["event"],
      "to": ["recovery", "protocol", "mesh", "storage", "chain", "client", "api", "mcp", "facade"],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "protocol-does-not-own-network",
      "action": "forbid",
      "from": ["protocol"],
      "to": ["mesh", "storage", "chain", "client", "api", "mcp", "facade"],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "mesh-is-a-port",
      "action": "forbid",
      "from": ["mesh"],
      "to": [
        "codec",
        "identity",
        "recovery",
        "event",
        "protocol",
        "storage",
        "chain",
        "client",
        "api",
        "mcp",
        "ads",
        "facade"
      ],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "storage-is-a-port",
      "action": "forbid",
      "from": ["storage"],
      "to": [
        "codec",
        "identity",
        "recovery",
        "event",
        "protocol",
        "mesh",
        "chain",
        "client",
        "api",
        "mcp",
        "facade"
      ],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "chain-is-a-port",
      "action": "forbid",
      "from": ["chain"],
      "to": [
        "codec",
        "identity",
        "recovery",
        "event",
        "protocol",
        "mesh",
        "storage",
        "client",
        "api",
        "mcp",
        "facade"
      ],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "api-is-the-host-surface",
      "action": "forbid",
      "from": ["api"],
      "to": ["storage", "chain", "client", "mcp", "facade"],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "ads-is-market-only",
      "action": "forbid",
      "from": ["ads"],
      "to": [
        "mesh",
        "protocol",
        "api",
        "mcp",
        "facade",
        "client",
        "storage",
        "chain",
        "identity"
      ],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "mcp-only-talks-to-the-host-api",
      "action": "forbid",
      "from": ["mcp"],
      "to": [
        "mesh",
        "storage",
        "chain",
        "client",
        "facade",
        "identity",
        "protocol",
        "recovery",
        "event",
        "codec"
      ],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "client-does-not-use-host-adapters",
      "action": "forbid",
      "from": ["client"],
      "to": ["api", "mcp", "facade"],
      "kinds": ["imports", "re_exports", "depends_on"]
    },
    {
      "id": "nobody-depends-on-the-facade",
      "action": "forbid",
      "from": [
        "core",
        "codec",
        "identity",
        "recovery",
        "event",
        "protocol",
        "mesh",
        "storage",
        "chain",
        "client",
        "api",
        "mcp",
        "ads"
      ],
      "to": ["facade"],
      "kinds": ["imports", "re_exports", "depends_on"]
    }
  ],
  "budgets": {
    "runtimeCycles": 0,
    "maxFileLoc": 300,
    "maxFunctionLoc": 100
  },
  "technologies": {
    "required": ["rust"],
    "forbidden": ["unsafe-rust"]
  },
  "exceptions": [],
  "ratchet": {
    "baseline": {
      "fingerprints": [],
      "metrics": {}
    }
  }
}
